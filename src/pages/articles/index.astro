---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VISIBLE_CATEGORIES } from '../../data/categories';
import { site } from '../../data/site';
---

<BaseLayout title="Articles" description={site.tagline}>
  <section class="py-10">
    <h1 class="text-3xl font-bold mb-6">Articles</h1>
    <div class="grid gap-4 sm:grid-cols-2">
      {VISIBLE_CATEGORIES.map((c) => (
        <a href={`/articles/${c.key}`} class="card bg-base-200 hover:bg-base-300 transition-colors">
          <div class="card-body p-4">
            <h2 class="card-title text-base">{c.label}</h2>
            <p class="text-sm opacity-70">{c.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
